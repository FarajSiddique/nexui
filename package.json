{
  "name": "nexui",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @nexui/mobile dev",
    "dev:api": "pnpm --filter @nexui/api dev",
    "dev:web": "pnpm --filter @nexui/mobile web",
    "build": "turbo run build",
    "build:preview": "pnpm --filter @nexui/mobile build:preview",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -r --if-present run lint:fix",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "turbo run typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "eval:travel": "node --experimental-strip-types scripts/eval-travel.mjs",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:push:dev": "node scripts/db-push.mjs dev",
    "db:push:prod": "node scripts/db-push.mjs prod",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nexui/config": "workspace:*",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "turbo": "^2.5.8"
  },
  "prettier": "@nexui/config/prettier"
}

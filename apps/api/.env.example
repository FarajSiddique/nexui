# Supabase (Settings → API Keys). Locally use nexui-dev. Not needed for the health endpoint.
SUPABASE_URL=
# sb_publishable_…
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… — server only; used for account deletion and the place media cache. Never expose
# to the mobile app.
SUPABASE_SECRET_KEY=

# Server credentials must remain in this API workspace and have no PUBLIC prefix.
# mock (the default: replays recorded fixtures, no network) or live (Vercel AI Gateway).
AI_PROVIDER=mock
# Needed when AI_PROVIDER=live.
AI_GATEWAY_API_KEY=
# Optional Gateway model ids. Defaults: typesafe-ai/jev, anthropic/claude-haiku-4.5 and
# anthropic/claude-sonnet-5.5. *_FALLBACKS lists are comma-separated and tried in order; an
# empty value turns fallbacks off, so leave them commented out to keep the defaults.
# NEXUI_MODEL_PERCEPTION=typesafe-ai/jev
# NEXUI_MODEL_FAST=anthropic/claude-haiku-4.5
# NEXUI_MODEL_REASONING=anthropic/claude-sonnet-5.5
# NEXUI_MODEL_FAST_FALLBACKS=anthropic/claude-sonnet-5
# NEXUI_MODEL_REASONING_FALLBACKS=anthropic/claude-sonnet-5

# An email address or URL Wikimedia can reach us at, sent in the User-Agent of Wikipedia
# lookups for stop details. Leave it empty to turn lookups off (cached places still show).
WIKIMEDIA_CONTACT=

# Dev-only: the QA smoke-test sign-in (scripts/qa-session.mjs). An address no real account
# uses, e.g. qa@nexui.test; no mail is sent.
QA_EMAIL=
# The nexui-dev project ref (the subdomain of SUPABASE_URL). The script refuses other projects.
QA_SUPABASE_REF=

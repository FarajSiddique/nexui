# Supabase (Settings → API Keys). Locally use nexui-dev. Not needed for the health endpoint.
SUPABASE_URL=
# sb_publishable_…
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… — server only; used by AI runs, account deletion and the place media cache. Never
# expose to the mobile app.
SUPABASE_SECRET_KEY=

# Sign in with Apple (Apple Developer → Keys) — server only; used to revoke an Apple user's
# access when they delete their account. Never expose to the mobile app.
# Team ID: 10 characters, under Membership details in your Apple Developer account.
APPLE_TEAM_ID=
# Key ID: 10 characters, shown with the key and in its file name, AuthKey_<KEY_ID>.p8.
APPLE_KEY_ID=
# The whole .p8 file in double quotes, BEGIN and END lines included. Keep its line breaks.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
replace these lines with the ones between BEGIN and END in AuthKey_<KEY_ID>.p8
-----END PRIVATE KEY-----"
# The iOS bundle ID.
APPLE_CLIENT_ID=ai.faraj.nexui

# Server credentials must remain in this API workspace and have no PUBLIC prefix.
# mock (the default: replays recorded fixtures, no network) or live (Vercel AI Gateway).
AI_PROVIDER=mock
# Job search reaches new goals only where the `job-search` Vercel flag (project nexui-api) is on;
# flip it in the Vercel dashboard, no deploy needed. Deployments read flags with their own OIDC
# token. Locally the API needs one too: `vercel link` in apps/api once (it writes a token here),
# or copy only the VERCEL_OIDC_TOKEN line from `vercel env pull` (never pull over this file).
# The token lasts about 12 hours; the client refreshes it through the link. Without one, flags
# read as off and job search doesn't route: re-run `vercel link` or re-pull.
# VERCEL_OIDC_TOKEN=
# Needed when AI_PROVIDER=live.
AI_GATEWAY_API_KEY=
# Optional Gateway model ids. Defaults: typesafe-ai/jev, anthropic/claude-haiku-5.5 and
# anthropic/claude-sonnet-5.5. *_FALLBACKS lists are comma-separated and tried in order; an
# empty value turns fallbacks off, so leave them commented out to keep the defaults.
# NEXUI_MODEL_PERCEPTION=typesafe-ai/jev
# NEXUI_MODEL_FAST=anthropic/claude-haiku-5.5
# NEXUI_MODEL_REASONING=anthropic/claude-sonnet-5.5
# NEXUI_MODEL_FAST_FALLBACKS=anthropic/claude-sonnet-5
# NEXUI_MODEL_REASONING_FALLBACKS=anthropic/claude-sonnet-5

# Shared secret for scheduled jobs (GET /api/cron/runs). Vercel sends it as a Bearer token to cron
# routes. Server only; at least 32 characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Optional. Most AI runs executing at once across all instances; the cron starts the rest. Default 100.
# RUN_MAX_ACTIVE=100

# An email address or URL Wikimedia can reach us at, sent in the User-Agent of Wikipedia
# lookups for stop details. Leave it empty to turn lookups off (cached places still show).
WIKIMEDIA_CONTACT=

# An email address or URL the job boards (Greenhouse, Lever, Ashby) can reach us at, sent in the
# User-Agent of job search's board lookups. Leave it empty to turn board lookups off.
NEXUI_CONTACT=

# Job search's web search (Parallel, parallel.ai). Server only. Leave it empty to turn web search
# off; scans then read only the boards of companies a user named. Production waits for Parallel's
# written answer on its acceptable-use policy (docs/superpowers/specs/2026-10-10-job-search-spikes.md).
PARALLEL_API_KEY=

# Dev-only: the QA smoke-test sign-in (scripts/qa-session.mjs). An address no real account
# uses, e.g. qa@nexui.test; no mail is sent.
QA_EMAIL=
# The nexui-dev project ref (the subdomain of SUPABASE_URL). The script refuses other projects.
QA_SUPABASE_REF=
